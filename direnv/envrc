pathAdd() {
  local d="$1"
  [ -n "$d" ] || return 0
  [ -d "$d" ] || return 0
  case ":$PATH:" in *":$d:"*) ;; *) export PATH="$d:$PATH" ;; esac
}

isGitRepo() {
  [ ! -d .git ] || return 0
  git rev-parse --is-inside-work-tree >/dev/null 2>&1
}

isGradleProject() {
  [ ! -f build.gradle ] || return 0
  [ ! -f build.gradle.kts ] || return 0
  [ ! -f settings.gradle ] || return 0
  [ ! -f settings.gradle.kts ] || return 0
  return 1
}

isMavenProject() {
  [ -f pom.xml ]
}

useProjectHistory() {
   export RAY_PROJECT_HISTORY=1
}

disableProjectHistory() {
  export RAY_PROJECT_HISTORY=0
}

loadSecretsIfPresent() {
  local f="${1:-.env.secrets}"
  [ -f "$f" ] || return 0
  # shellcheck disable=SC1090
  source "$f"
}

loadCentralSecrets() {
  local f="${1:-$HOME/.secrets/env.llm}"
  loadSecretsIfPresent "$f"
}

useJava() {
  local jh="$1"
  [ -n "$jh" ] || return 0
  if [ ! -d "$jh" ]; then
    echo "direnv: JAVA_HOME not found: $jh" >&2
    return 1
  fi
  export JAVA_HOME="$jh"
  pathAdd "$JAVA_HOME/bin"
}

useJavaFromFile() {
  local f="${1:-.java-home}"
  [ -f "$f" ] || return 0
  local jh
  jh="$(tr -d '\r\n' < "$f")"
  useJava "$jh"
}

useGradleCacheLocal() {
  export GRADLE_USER_HOME="$PWD/.gradle"
}

useGradleCacheShared() {
  local d="$1"
  [ -n "$d" ] || return 0
  mkdir -p "$d" 2>/dev/null || true
  export GRADLE_USER_HOME="$d"
}

useNodeBin() {
  pathAdd "$PWD/node_modules/.bin"
}

requireFile() {
  local f="$1"
  local msg="${2:-Missing required file: $f}"
  if [ ! -f "$f" ]; then
    echo "direnv: $msg" >&2
    return 1
  fi
}

requireDir() {
  local d="$1"
  local msg="${2:-Missing required directory: $d}"
  if [ ! -d "$d" ]; then
    echo "direnv: $msg" >&2
    return 1
  fi
}

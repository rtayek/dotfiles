<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>PROJECT_NAME project links</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 24px;
      background: #000000;
      color: #ffffff;
    }

    body {
      max-width: 48rem;
      margin: 0 auto;
      padding: 1.5rem;
      background: #000000;
      color: #ffffff;
    }

    h1 {
      margin: 0 0 1.5rem;
      font-size: 2rem;
      line-height: 1.2;
    }

    ul {
      display: grid;
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    a {
      display: block;
      padding: 1rem 1.25rem;
      border: 4px solid #ffff00;
      border-radius: 0.25rem;
      background: #000000;
      color: #ffff00;
      font-size: 1.25rem;
      font-weight: 700;
      line-height: 1.3;
      text-decoration: underline;
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.15em;
    }

    a:hover,
    a:focus-visible {
      background: #ffff00;
      color: #000000;
      outline: 5px solid #ff0000;
      outline-offset: 4px;
    }

    @media (forced-colors: active) {
      a {
        border-color: LinkText;
      }
    }
  </style>
</head>
<body>
  <h1>PROJECT_NAME project links</h1>
  <ul>
    <li><a href="BASH_URL" target="_blank">Bash</a></li>
    <li><a href="file:///C:/Users/ray/bin/web/editor.html" target="_blank">Editor</a></li>
    <li><a href="CHATGPT_URL" target="_blank">ChatGPT</a></li>
    <li><a href="CLAUDE_URL" target="_blank">Claude</a></li>
    <li><a href="https://gemini.google.com/app" target="_blank">Gemini</a></li>
    <li><a href="GITHUB_URL" target="_blank">GitHub - PROJECT_NAME</a></li>
  </ul>
</body>
</html>

case $- in
  *i*) ;;
  *) return ;;
esac

__ray_bash_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

ray_shell_platform() {
  case "${RAY_DOTFILES_UNAME_S:-$(uname -s 2>/dev/null || printf unknown)}" in
    MINGW*) printf '%s\n' mingw ;;
    MSYS*) printf '%s\n' msys ;;
    Linux*) printf '%s\n' linux ;;
    *) printf '%s\n' unknown ;;
  esac
}

ray_linux_distribution() {
  if [ -n "${RAY_DOTFILES_OS_ID-}" ]; then
    printf '%s\n' "$RAY_DOTFILES_OS_ID"
    return
  fi

  if [ -r /etc/os-release ]; then
    (
      . /etc/os-release
      printf '%s\n' "${ID:-linux}"
    )
    return
  fi

  printf '%s\n' linux
}

ray_windows_home_path() {
  case "$1" in
    /mnt/[A-Za-z]/Users/*|/[A-Za-z]/Users/*|[A-Za-z]:/*|[A-Za-z]:\\*) return 0 ;;
    *) return 1 ;;
  esac
}

ray_linux_login_home() {
  local login_user login_entry login_home

  login_user="${USER:-$(id -un 2>/dev/null || printf '')}"
  [ -n "$login_user" ] || return 1

  if command -v getent >/dev/null 2>&1; then
    login_entry="$(getent passwd "$login_user" 2>/dev/null || printf '')"
    login_home="$(printf '%s\n' "$login_entry" | awk -F: 'NF >= 6 { print $6; exit }')"
    if [ -n "$login_home" ] && ! ray_windows_home_path "$login_home"; then
      printf '%s\n' "$login_home"
      return 0
    fi
  fi

  printf '/home/%s\n' "$login_user"
}

ray_fix_ubuntu_home() {
  local login_home

  ray_windows_home_path "${HOME-}" || return 0
  login_home="$(ray_linux_login_home)" || return 0
  [ -n "$login_home" ] || return 0

  export HOME="$login_home"
}

__ray_shell_platform="$(ray_shell_platform)"
__ray_linux_distribution=

if [ "$__ray_shell_platform" = linux ]; then
  __ray_linux_distribution="$(ray_linux_distribution)"
  if [ "$__ray_linux_distribution" = ubuntu ]; then
    ray_fix_ubuntu_home
  fi
fi

. "$__ray_bash_dir/bashrc-common"

case "$__ray_shell_platform" in
  mingw|msys)
    . "$__ray_bash_dir/bashrc-windows"
    ;;
  linux)
    if [ "$__ray_linux_distribution" = ubuntu ]; then
      . "$__ray_bash_dir/bashrc-ubuntu"
    fi
    ;;
esac

. "$__ray_bash_dir/bashrc-project-history"

dedupePath
export PATH

PROMPT_DIRTRIM=2
PS1='\u@\h \W \$ '

unset __ray_bash_dir __ray_shell_platform __ray_linux_distribution

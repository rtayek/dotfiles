export RAY_TERMINAL_TITLE_PREFIX=WSL

if [ -f "${HOME}/.bash_functions-ubuntu" ]; then
  . "${HOME}/.bash_functions-ubuntu"
elif [ -f "$HOME/dotfiles/bash/bash_functions-ubuntu" ]; then
  . "$HOME/dotfiles/bash/bash_functions-ubuntu"
fi

[ -d "$HOME/dev" ] && export RAY_DEV_HOME="$HOME/dev"
[ -d "$HOME/.npm-global/bin" ] && pathPrepend "$HOME/.npm-global/bin"

export RAY_EXPECTED_WSL_DISTRO="Ubuntu"

[ -f "$HOME/anaconda3/etc/profile.d/conda.sh" ] &&
  . "$HOME/anaconda3/etc/profile.d/conda.sh"
